{
  "manifest_version": 3,
  "name": "Gemini Translator",
  "version": "2.0",
  "description": "Dịch văn bản bôi đen và phân tích tiếng Nhật với Gemini AI",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "options_page": "manager.html",
  "host_permissions": [
    "https://generativelanguage.googleapis.com/",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/utils.js",
        "src/shared/storage-service.js",
        "src/content/styles.js",
        "src/content/popup-ui.js",
        "src/content/history.js",
        "src/content/index.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mở Gemini Japanese"
  },
  "commands": {
    "cmd_translate": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "1. Dịch nhanh (Gemini Flash Lite)"
    },
    "cmd_analyze": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "2. Phân tích ngữ pháp (Gemini Flash 2.5)"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "3. Mở Menu/Sổ tay (Click Icon)"
    },
    "cmd_reload_extension": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": " Reload Extension & Webpage"
    }
  }
}